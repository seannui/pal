<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.seanporter.pal</string>

    <key>WorkingDirectory</key>
    <string>/Users/sporter/git/pal</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-lc</string>
        <string>cd /Users/sporter/git/pal &amp;&amp; exec /opt/homebrew/bin/mise exec -- bin/rails solid_queue:start</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/sporter/git/pal/log/solid_queue.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/sporter/git/pal/log/solid_queue.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>RAILS_ENV</key>
        <string>development</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
